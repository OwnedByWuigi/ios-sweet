@@ -1856,10 +1856,10 @@ sleh_irq(arm_saved_state_t *state)
 #endif
 
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(S10)
 	/*
-	 * sweet: TrustZone owns GIC Group 0, so the timer and IPIs that other
-	 * ARM64 targets take as FIQs arrive here as Group 1 IRQs.
+	 * Group 1 timer/IPI delivery arrives through IRQ (see pe_init_fiq).
+	 * The S10 path assumes non-secure Group 1 and is not device-verified.
 	 */
 	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");
 	uint32_t intid = (uint32_t)(iar & 0xFFFFFF);
@@ -1867,7 +1867,11 @@ sleh_irq(arm_saved_state_t *state)
 	if (intid >= 1020 && intid <= 1023) {
 		return; /* spurious */
 	}
+#if defined(S10)
+	if (intid == S10_VTIMER_INTID) {
+#else
 	if (intid == SWEET_VTIMER_INTID) {
+#endif
 		sleh_interrupt_handler_prologue(state, DBG_INTR_TYPE_TIMER);
 		cdp->cpu_decrementer = -1; /* Large */
 		INTERRUPT_MASKED_DEBUG_START(rtclock_intr, DBG_INTR_TYPE_TIMER);
diff --git a/pexpert/arm/pe_fiq.c b/pexpert/arm/pe_fiq.c
index 4ec6989..78bb7e4 100644
--- a/pexpert/arm/pe_fiq.c
+++ b/pexpert/arm/pe_fiq.c
@@ -141,18 +141,21 @@ pe_init_fiq()
 		}
 	}
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(S10)
 	/*
-	 * Real hardware with two security states: Group 0 is TrustZone's and
-	 * non-secure writes to it are ignored. Everything we own is Group 1 NS
-	 * and arrives as an IRQ (see sleh_irq). GICR_IGROUPR0 reads as zero
-	 * from the non-secure side even after this write; delivery still works.
+	 * Configure timer and IPI PPIs in non-secure Group 1, delivered through
+	 * IRQ (see sleh_irq). This route is verified on sweet and is the initial
+	 * hardware assumption for S10; confirm it against stock S10 firmware.
 	 */
 	gicr_write32(GICR_IGROUPR0, 0xFFFFFFFF);
 	for (unsigned int i = 0; i < 32; i += 4) {
 		gicr_write32(GICR_IPRIORITYR0 + i, 0xA0A0A0A0);
 	}
+#if defined(S10)
+	gicr_write32(GICR_ISENABLER0, (1U << S10_VTIMER_INTID) | (1U << S10_IPI_SGI));
+#else
 	gicr_write32(GICR_ISENABLER0, (1U << SWEET_VTIMER_INTID) | (1U << SWEET_IPI_SGI));
+#endif
 #else
 	// Configure timers and legacy FIQ to be group 0
 	gicr_write32(GICR_IGROUPR0, 0x81FFFFFF);
@@ -167,7 +170,7 @@ pe_init_fiq()
 	__builtin_arm_wsr64("ICC_SRE_EL1", icc_sre);
 	__builtin_arm_isb(ISB_SY);
 
-#if defined(SWEET)
+#if defined(SWEET) || defined(S10)
 	__builtin_arm_wsr64("ICC_BPR1_EL1", 0);
 #else
 	// Set priority masks and binary point for group 0
@@ -180,8 +183,8 @@ pe_init_fiq()
 	icc_ctlr &= ~ICC_CTLR_EOIMODE;
 	__builtin_arm_wsr64("ICC_CTLR_EL1", icc_ctlr);
 
-#if defined(SWEET)
-	// ABL leaves only ARE_NS set; Linux writes ARE_NS | EnableGrp1A | EnableGrp1
+#if defined(SWEET) || defined(S10)
+	// Enable affinity routing and Group 1 forwarding for the non-secure state.
 	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
 	gicd_ctlr |= GICD_CTLR_ARE_NS | GICD_CTLR_ENABLEGRP1A | GICD_CTLR_ENABLEGRP1;
 	gicd_write32(GICD_CTLR, gicd_ctlr);
diff --git a/pexpert/pexpert/arm64/S10.h b/pexpert/pexpert/arm64/S10.h
index 3d504c3..58668fa 100644
--- a/pexpert/pexpert/arm64/S10.h
+++ b/pexpert/pexpert/arm64/S10.h
@@ -1,7 +1,8 @@
 /*
  * Initial XNU machine configuration for the Galaxy S10 Exynos target.
- * This is a compile target only; it does not yet encode Samsung's boot
- * handoff, interrupt routing, memory carve-outs, or board peripherals.
+ * The GICv3 Group 1/IRQ route and virtual timer PPI are initial assumptions
+ * that must be checked against S10 firmware before a device boot.
+ * Samsung's boot handoff and memory carve-outs are not encoded here.
  */
 #ifndef _PEXPERT_ARM64_S10_H
 #define _PEXPERT_ARM64_S10_H
@@ -21,7 +22,27 @@
 #define __ARM_16K_PG__            1
 
 #define HAS_GIC_V3                1
+#define S10_VTIMER_INTID          27
+#define S10_IPI_SGI               1
 #define GIC_SPURIOUS_IRQ          1023
 #define GICR_PE_SIZE              0x20000
 
+/* GICv3 system register and redistributor definitions (Arm IHI 0069). */
+#define GICD_CTLR                 0x0
+#define GICD_CTLR_ENABLEGRP1      0x1
+#define GICD_CTLR_ENABLEGRP1A     0x2
+#define GICD_CTLR_ARE_NS          0x10
+#define GICD_CTLR_RWP             0x80000000
+#define GICR_TYPER                0x08
+#define GICR_WAKER                0x14
+#define GICR_IGROUPR0             0x10080
+#define GICR_ISENABLER0           0x10100
+#define GICR_IPRIORITYR0          0x10400
+#define GICR_TYPER_AFFINITY_VALUE_SHIFT 32
+#define GICR_TYPER_LAST           0x10
+#define GICR_WAKER_PROCESSORSLEEP 0x2
+#define GICR_WAKER_CHILDRENASLEEP 0x4
+#define ICC_CTLR_EOIMODE           0x2
+#define ICC_SRE_SRE                0x1
+
 #endif /* _PEXPERT_ARM64_S10_H */
