diff --git a/iokit/Kernel/arm/S10CPU.cpp b/iokit/Kernel/arm/S10CPU.cpp
index 6c87ce0..db5dea7 100644
--- a/iokit/Kernel/arm/S10CPU.cpp
+++ b/iokit/Kernel/arm/S10CPU.cpp
@@ -12,6 +12,9 @@
 #include <libkern/c++/OSNumber.h>
 #include <kern/clock.h>
 #include <kern/processor.h>
+#include <arm/machine_cpu.h>
+#include <arm64/proc_reg.h>
+#include <mach/mach_time.h>
 
 class S10CPU : public IOCPU {
 	OSDeclareDefaultStructors(S10CPU);
@@ -101,15 +104,41 @@ S10CPU::initCPU(bool boot)
 		panic("S10 CPU: secondary CPU startup is not implemented");
 	}
 	assert(cpu_number() == (int)getCPUNumber());
+	assert(ml_get_interrupts_enabled());
 	ml_broadcast_cpu_event(CPU_BOOTED, getCPUNumber());
+
+	/* Self-IPI clears XNU's SIGPdisabled state and verifies GIC routing. */
+	uint64_t deadline;
+	nanoseconds_to_deadline(NSEC_PER_SEC, &deadline);
+	signalCPU(this);
+	while (!ml_cpu_signal_is_enabled()) {
+		if (mach_absolute_time() > deadline) {
+			panic("S10 CPU: GIC SGI self-test timed out");
+		}
+		__asm__ volatile("yield");
+	}
 	setCPUState(kIOCPUStateRunning);
 }
 
 void
 S10CPU::signalCPU(IOCPU *target)
 {
-	panic("S10 CPU: interprocessor signaling is not implemented (target %u)",
-	    target ? target->getCPUNumber() : (unsigned int)-1);
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	if (target == NULL || target->getCPUNumber() >= topology->num_cpus) {
+		panic("S10 CPU: invalid SGI target");
+	}
+	uint64_t mpidr = topology->cpus[target->getCPUNumber()].phys_id;
+	unsigned int aff0 = mpidr & 0xff;
+	if (aff0 >= 16) {
+		panic("S10 CPU: SGI target Aff0 %u is out of range", aff0);
+	}
+	uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
+	    (((mpidr >> 16) & 0xff) << 32) |
+	    (((mpidr >> 8) & 0xff) << 16) |
+	    ((uint64_t)S10_IPI_SGI << 24) | (1ULL << aff0);
+	__builtin_arm_dsb(DSB_ISHST);
+	__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
+	__builtin_arm_isb(ISB_SY);
 }
 
 kern_return_t
diff --git a/osfmk/arm64/sleh.c b/osfmk/arm64/sleh.c
